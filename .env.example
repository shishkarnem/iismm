# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Public URL of the application.
APP_URL="YOUR_APP_URL"

# ProTalk Cloud PostgreSQL Database (iismm2)
PROTALK_DB_BASE_URL="https://db.pro-talk.ru"
PROTALK_DB_NAME="iismm2"
PROTALK_DB_USER_ID="YOUR_PROTALK_DB_USER_ID"

# ProTalk TGF File Storage (store only URLs in PostgreSQL, never Base64/binaries)
PROTALK_FILE_UPLOAD_URL="https://file.pro-talk.ru/tgf"
PROTALK_UPLOAD_TOKEN="YOUR_PROTALK_UPLOAD_TOKEN"

# ProTalk AI Bot Integration
PROTALK_BOT_ID="YOUR_PROTALK_BOT_ID"
PROTALK_BOT_TOKEN="YOUR_PROTALK_BOT_TOKEN"

# Telegram Bot Proxy & Backup Delivery
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_API_BASE="https://eu1.account.dialog.ai.atiks.org"
ADMIN_TELEGRAM_ID="169262990"
